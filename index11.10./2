<!DOCTYPE html>
<html lang="de">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="theme-color" content="#f4f7fb">
<title>Pädagogischer KI-Assistent – Version 3.3</title>
<style>
:root{--ink:#17243a;--muted:#68758a;--blue:#315fce;--pale:#eaf0ff;--line:#e1e7f0;--bg:#f4f7fb;--white:#fff;--green:#157347;--red:#b42318;--shadow:0 8px 26px #20304c0d}*{box-sizing:border-box}body{margin:0;background:var(--bg);color:var(--ink);font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;line-height:1.45}.app{max-width:760px;margin:auto;min-height:100vh;padding:18px 16px 100px}.top{display:flex;justify-content:space-between;align-items:center;gap:12px;margin-bottom:20px}.brand{font-size:12px;letter-spacing:.07em;text-transform:uppercase;color:var(--muted);font-weight:800}.version{font-size:12px;color:var(--muted);background:#e9edf4;padding:5px 9px;border-radius:20px}h1{font-size:clamp(27px,6vw,38px);line-height:1.12;letter-spacing:-.04em;margin:4px 0 8px}h2{font-size:22px;margin:0 0 12px;letter-spacing:-.025em}h3{font-size:16px;margin:0 0 6px}p{margin:0 0 12px}.muted{color:var(--muted)}.small{font-size:13px}.card{background:var(--white);border:1px solid var(--line);border-radius:20px;padding:18px;margin:14px 0;box-shadow:var(--shadow)}.hero{padding:24px 20px;background:linear-gradient(145deg,#fff,#edf2ff)}.eyebrow{font-size:13px;font-weight:750;color:var(--blue);margin-bottom:8px}.mic-wrap{text-align:center;padding:22px 10px 10px}.mic{width:104px;height:104px;border-radius:50%;border:0;background:var(--blue);color:white;font-size:39px;box-shadow:0 8px 0 #244ba9,0 12px 28px #315fce30;touch-action:none;user-select:none;-webkit-user-select:none;cursor:pointer;transition:transform .12s,background .12s}.mic:active,.mic.recording{transform:scale(.96);background:#b42318;box-shadow:0 5px 0 #8d1b13,0 10px 22px #b4231825}.mic.recording{animation:pulse 1s infinite}.mic:disabled{opacity:.5;cursor:not-allowed}@keyframes pulse{50%{box-shadow:0 0 0 12px #b4231820,0 5px 0 #8d1b13}}.mic-label{font-weight:750;margin-top:17px}.status{font-size:13px;color:var(--muted);min-height:20px;margin-top:5px}.btn{border:0;border-radius:12px;background:var(--blue);color:#fff;padding:12px 16px;font-size:15px;font-weight:750;cursor:pointer}.btn.secondary{background:#edf1f8;color:var(--ink)}.btn.danger{background:#fff0ef;color:var(--red)}.btn:disabled{opacity:.45;cursor:not-allowed}.btnrow{display:flex;gap:9px;flex-wrap:wrap;margin-top:14px}.btnrow .btn{flex:1}.field{margin:13px 0}.field label{display:block;font-size:13px;font-weight:750;margin-bottom:6px}.field input,.field textarea,.field select{display:block;width:100%;border:1px solid #cfd7e4;border-radius:11px;background:#fff;padding:12px;font:inherit;color:var(--ink)}textarea{min-height:130px;resize:vertical}.nav{position:fixed;z-index:10;bottom:0;left:0;right:0;background:#ffffffed;backdrop-filter:blur(12px);border-top:1px solid var(--line);display:flex;justify-content:center;padding:8px max(8px,env(safe-area-inset-right)) calc(8px + env(safe-area-inset-bottom)) max(8px,env(safe-area-inset-left))}.nav-inner{width:100%;max-width:760px;display:flex;gap:5px}.nav button{flex:1;background:transparent;border:0;border-radius:12px;padding:8px 2px;color:var(--muted);font-size:11px;font-weight:700;cursor:pointer}.nav button span{display:block;font-size:20px;margin-bottom:2px}.nav button.active{background:var(--pale);color:var(--blue)}.student-row,.obs-row{display:flex;align-items:flex-start;gap:12px;padding:13px 0;border-bottom:1px solid var(--line)}.student-row:last-child,.obs-row:last-child{border-bottom:0}.avatar{width:42px;height:42px;flex:0 0 42px;border-radius:13px;background:var(--pale);display:grid;place-items:center;color:var(--blue);font-weight:800}.grow{flex:1;min-width:0}.right{margin-left:auto}.tag{display:inline-block;background:#eef2f7;color:#4d5a6d;padding:4px 8px;border-radius:8px;font-size:12px;margin:3px 4px 0 0}.empty{text-align:center;padding:22px 10px;color:var(--muted)}.notice{border-radius:12px;background:#fff6df;color:#765000;padding:12px;font-size:13px;margin:12px 0}.success{color:var(--green);font-weight:750}.hidden{display:none!important}.count{font-size:12px;color:var(--muted)}.section-title{display:flex;align-items:center;justify-content:space-between;gap:10px}.linkbtn{border:0;background:transparent;color:var(--blue);font-weight:750;padding:8px;cursor:pointer}.privacy{font-size:12px;color:var(--muted);padding:6px 3px}.pill{display:inline-block;border-radius:99px;padding:5px 9px;background:#e7f7ee;color:var(--green);font-size:12px;font-weight:750}
</style>
</head>
<body>
<div class="app">
  <div class="top"><div class="brand">Pädagogischer KI-Assistent</div><div class="version">Version 3.3 · Test</div></div>
  <main id="view"></main>
</div>
<nav class="nav" aria-label="Hauptnavigation"><div class="nav-inner">
<button data-page="home"><span>⌂</span>Start</button><button data-page="students"><span>♙</span>Schüler</button><button data-page="chronicle"><span>▤</span>Chronik</button><button data-page="data"><span>⇩</span>Daten</button>
</div></nav>
<script>
(()=>{'use strict';
const K_STUDENTS='pki_students_v32',K_OBS='pki_observations_v32',K_CURRENT='pki_current_student_v32';
const $=id=>document.getElementById(id);const esc=s=>String(s??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
let students=readArray(K_STUDENTS),observations=readArray(K_OBS),page='home',draftText='',draftStudentId='',recognition=null,isRecording=false,finalTranscript='',chosenChronicleId='';
function readArray(k){try{const v=JSON.parse(localStorage.getItem(k)||'[]');return Array.isArray(v)?v:[]}catch{return []}}
function saveData(){localStorage.setItem(K_STUDENTS,JSON.stringify(students));localStorage.setItem(K_OBS,JSON.stringify(observations))}
function id(){return 's'+Date.now().toString(36)+Math.random().toString(36).slice(2,7)}
function studentName(s){return s.name||[s.firstName,s.lastName].filter(Boolean).join(' ')||s.fullName||'Unbenannt'}
function initials(s){return studentName(s).split(/\s+/).map(x=>x[0]||'').join('').slice(0,2).toUpperCase()}
function getStudent(sid){return students.find(s=>String(s.id)===String(sid))}
function go(p){page=p;render()}
function detectStudent(text){const t=(text||'').toLocaleLowerCase('de');const hits=[];for(const s of students){const n=studentName(s).trim();if(!n||n==='Unbenannt')continue;const parts=n.split(/\s+/);const full=n.toLocaleLowerCase('de');if(t.includes(full)||parts.some(part=>part.length>2&&new RegExp('(^|[^\\p{L}])'+part.replace(/[.*+?^${}()|[\]\\]/g,'\\$&')+'([^\\p{L}]|$)','iu').test(text||'')))hits.push(s)}return [...new Map(hits.map(s=>[String(s.id),s])).values()]}
function setActiveNav(){document.querySelectorAll('.nav button').forEach(b=>b.classList.toggle('active',b.dataset.page===page||(page==='profile'&&b.dataset.page==='students')))}
function render(){setActiveNav();const v=$('view');if(page==='home')v.innerHTML=homeHTML();else if(page==='students')v.innerHTML=studentsHTML();else if(page==='studentForm')v.innerHTML=formHTML();else if(page==='profile')v.innerHTML=profileHTML();else if(page==='review')v.innerHTML=reviewHTML();else if(page==='chronicle')v.innerHTML=chronicleHTML();else if(page==='data')v.innerHTML=dataHTML();bind()}
function homeHTML(){return `<section class="hero card"><div class="eyebrow">Einmal beobachten. Alles dokumentieren.</div><h1>Guten Tag! 👋</h1><p class="muted">Halte eine Beobachtung fest. Prüfe den Text und ordne ihn dem richtigen Schüler zu, bevor du speicherst.</p><div class="mic-wrap"><button id="homeMic" class="mic" aria-label="Zum Sprechen gedrückt halten">🎙️</button><div class="mic-label">Mikrofon gedrückt halten</div><div id="micStatus" class="status" aria-live="polite">Zum Starten gedrückt halten, zum Beenden loslassen.</div></div><div class="btnrow"><button class="btn secondary" id="typeInstead">✎ Text eingeben</button><button class="btn" id="studentsFromHome">Schüler verwalten</button></div></section><section class="card"><div class="section-title"><h2>Letzte Beobachtungen</h2><span class="count">${observations.length}</span></div>${observations.length?observations.slice().sort((a,b)=>(b.createdAt||b.date||'').localeCompare(a.createdAt||a.date||'')).slice(0,3).map(o=>obsCard(o,false)).join(''):`<div class="empty">Hier erscheinen deine gespeicherten Beobachtungen.<br>Auf der Startseite wird bewusst kein Schüler vorausgewählt.</div>`}</section><p class="privacy">🔒 Testversion: Daten werden in diesem Browser gespeichert. Bitte zunächst nur mit Testdaten arbeiten.</p>`}
function studentsHTML(){return `<div class="section-title"><div><h1>Schüler</h1><p class="muted">Lege Testprofile an und öffne ihre Chronik.</p></div><button class="btn" id="addStudent">＋ Anlegen</button></div><section class="card">${students.length?students.map(s=>`<div class="student-row"><div class="avatar">${esc(initials(s))}</div><div class="grow"><h3>${esc(studentName(s))}</h3><div class="muted small">${esc(s.className||s.klasse||'Keine Klasse eingetragen')}</div><div class="count">${observations.filter(o=>String(o.studentId)===String(s.id)).length} Beobachtung(en)</div></div><button class="btn secondary" data-profile="${esc(s.id)}">Öffnen</button></div>`).join(''):`<div class="empty">Noch keine Schüler angelegt.<br>Lege zuerst ein Testprofil an oder beginne mit einer Texteingabe.</div>`}</section>`}
function formHTML(){return `<h1>Schüler anlegen</h1><p class="muted">Nur die Angaben eintragen, die du für deinen Test brauchst.</p><form id="studentForm" class="card"><div class="field"><label for="studentName">Vor- und Nachname *</label><input id="studentName" required autocomplete="off" placeholder="z. B. Robert Beispiel"></div><div class="field"><label for="studentClass">Klasse (optional)</label><input id="studentClass" placeholder="z. B. 3a"></div><div class="field"><label for="studentFocus">Förderbereich (optional)</label><input id="studentFocus" placeholder="z. B. Kommunikation"></div><div class="btnrow"><button type="button" class="btn secondary" id="cancelStudent">Abbrechen</button><button class="btn" type="submit">Schüler speichern</button></div></form>`}
function profileHTML(){const s=getStudent(chosenChronicleId);if(!s)return `<h1>Schülerprofil</h1><p>Schüler nicht gefunden.</p><button class="btn" id="toStudents">Zur Schülerliste</button>`;const list=observations.filter(o=>String(o.studentId)===String(s.id)).sort((a,b)=>(b.createdAt||b.date||'').localeCompare(a.createdAt||a.date||''));return `<button class="linkbtn" id="backStudents">← Schülerliste</button><h1>${esc(studentName(s))}</h1><p class="muted">${esc(s.className||s.klasse||'Keine Klasse eingetragen')}${s.focus?' · '+esc(s.focus):''}</p><section class="card"><div class="section-title"><h2>Chronik</h2><span class="count">${list.length} Einträge</span></div>${list.length?list.map(o=>obsCard(o,true)).join(''):`<div class="empty">Für diesen Schüler gibt es noch keine Beobachtungen.</div>`}</section><button class="btn" id="observeForStudent" data-id="${esc(s.id)}">＋ Beobachtung für ${esc(studentName(s))}</button>`}
function obsCard(o,showStudent){const s=getStudent(o.studentId);const dt=o.createdAt||o.date||'';let date='';try{date=dt?new Date(dt).toLocaleString('de-DE',{dateStyle:'medium',timeStyle:'short'}):''}catch{}return `<div class="obs-row"><div class="avatar">▤</div><div class="grow"><div class="count">${esc(date)}${showStudent&&s?' · '+esc(studentName(s)):''}</div><p style="margin:5px 0 7px">${esc(o.text||o.observation||o.content||'')}</p>${(o.categories||[]).map(c=>`<span class="tag">${esc(c)}</span>`).join('')}</div></div>`}
function reviewHTML(){const hits=detectStudent(draftText);let selected=draftStudentId;if(!selected&&hits.length===1)selected=String(hits[0].id);return `<button class="linkbtn" id="backHome">← Zurück</button><h1>Beobachtung prüfen</h1><p class="muted">Bitte prüfe den erkannten Text und bestätige die Zuordnung. Erst danach wird gespeichert.</p><section class="card"><div class="field"><label for="draftText">Beobachtungstext</label><textarea id="draftText" placeholder="Sprich oder schreibe deine Beobachtung …">${esc(draftText)}</textarea></div><div class="field"><label for="draftStudent">Welchem Schüler gehört die Beobachtung?</label><select id="draftStudent"><option value="">Bitte Schüler auswählen …</option>${students.map(s=>`<option value="${esc(s.id)}" ${String(selected)===String(s.id)?'selected':''}>${esc(studentName(s))}</option>`).join('')}</select></div>${hits.length>1?`<div class="notice">Im Text wurden mehrere mögliche Schülernamen gefunden. Bitte die richtige Person ausdrücklich auswählen.</div>`:''}${!students.length?`<div class="notice">Es gibt noch keine Schülerprofile. Lege zuerst einen Schüler an; der Text bleibt bis dahin hier erhalten.</div>`:''}<div class="field"><label>Dokumentationsbereiche (Vorschläge)</label><div><span class="tag">Beobachtungsnotiz</span><span class="tag">Förderplan-Baustein</span><span class="tag">Entwicklungsverlauf</span></div><p class="small muted">Die Kategorien sind in dieser Testversion Vorschläge und keine echte KI-Auswertung.</p></div><div class="btnrow"><button class="btn secondary" id="cancelReview">Verwerfen</button><button class="btn" id="saveObservation" ${!students.length?'disabled':''}>Zuordnen und speichern</button></div><div id="reviewMsg" class="status"></div></section>`}
function chronicleHTML(){return `<h1>Chronik</h1><p class="muted">Wähle einen Schüler, um nur dessen Beobachtungen zu sehen.</p><section class="card">${students.length?students.map(s=>`<div class="student-row"><div class="avatar">${esc(initials(s))}</div><div class="grow"><h3>${esc(studentName(s))}</h3><div class="count">${observations.filter(o=>String(o.studentId)===String(s.id)).length} Eintrag/Einträge</div></div><button class="btn secondary" data-profile="${esc(s.id)}">Chronik</button></div>`).join(''):`<div class="empty">Noch keine Schüler angelegt.</div>`}</section>`}
function dataHTML(){return `<h1>Daten</h1><p class="muted">Exportiere deine Testdaten oder lösche sie aus diesem Browser.</p><section class="card"><h2>Datensicherung</h2><p class="small muted">Der Export enthält Schülerprofile und Beobachtungen als JSON-Datei.</p><button class="btn" id="exportData">Daten exportieren</button></section><section class="card"><h2>Browser-Speicherung</h2><p class="small muted">Diese Testversion verwendet localStorage. Das ist keine zentrale, schulisch verwaltete Datenbank und keine sichere Mehrgeräte-Synchronisierung.</p><button class="btn danger" id="clearData">Alle Testdaten löschen</button></section><section class="card"><h2>Über diese Version</h2><p>Version 3.3 · Schülerzuordnung vor dem Speichern · Schülerchronik · Spracheingabe im Browser</p><p class="small muted">Die Analyse ist noch eine transparente Demo; es besteht keine echte KI-Anbindung.</p></section>`}
function startDraft(text){draftText=text||'';draftStudentId='';const hits=detectStudent(draftText);if(hits.length===1)draftStudentId=String(hits[0].id);go('review')}
function startTyped(){draftText='';draftStudentId='';go('review')}
function bind(){document.querySelectorAll('[data-profile]').forEach(b=>b.onclick=()=>{chosenChronicleId=b.dataset.profile;go('profile')});if($('homeMic'))setupMic($('homeMic'));if($('typeInstead'))$('typeInstead').onclick=startTyped;if($('studentsFromHome'))$('studentsFromHome').onclick=()=>go('students');if($('addStudent'))$('addStudent').onclick=()=>go('studentForm');if($('cancelStudent'))$('cancelStudent').onclick=()=>go('students');if($('studentForm'))$('studentForm').onsubmit=e=>{e.preventDefault();const name=$('studentName').value.trim();if(!name)return;const s={id:id(),name,className:$('studentClass').value.trim(),focus:$('studentFocus').value.trim(),createdAt:new Date().toISOString()};students.push(s);saveData();chosenChronicleId=String(s.id);go('profile')};if($('backStudents'))$('backStudents').onclick=()=>go('students');if($('toStudents'))$('toStudents').onclick=()=>go('students');if($('observeForStudent'))$('observeForStudent').onclick=()=>{draftText='';draftStudentId=$('observeForStudent').dataset.id;go('review')};if($('backHome'))$('backHome').onclick=()=>go('home');if($('cancelReview'))$('cancelReview').onclick=()=>{draftText='';draftStudentId='';go('home')};if($('draftText'))$('draftText').oninput=e=>{draftText=e.target.value;const sel=$('draftStudent');const hits=detectStudent(draftText);if(hits.length===1&&!sel.value){sel.value=String(hits[0].id);draftStudentId=sel.value}};if($('draftStudent'))$('draftStudent').onchange=e=>draftStudentId=e.target.value;if($('saveObservation'))$('saveObservation').onclick=saveObservation;if($('exportData'))$('exportData').onclick=exportData;if($('clearData'))$('clearData').onclick=clearData}
function setupMic(btn){const status=$('micStatus');const SR=window.SpeechRecognition||window.webkitSpeechRecognition;if(!SR){status.textContent='Spracherkennung ist in diesem Browser nicht verfügbar. Bitte „Text eingeben“ verwenden.';btn.disabled=true;return}let pressStarted=false;function begin(e){if(e)e.preventDefault();if(isRecording)return;pressStarted=true;draftText='';finalTranscript='';try{recognition=new SR();recognition.lang='de-DE';recognition.continuous=true;recognition.interimResults=true;recognition.onstart=()=>{isRecording=true;btn.classList.add('recording');status.textContent='Ich höre zu … Zum Beenden loslassen.'};recognition.onresult=ev=>{let interim='';for(let i=ev.resultIndex;i<ev.results.length;i++){const phrase=ev.results[i][0].transcript;if(ev.results[i].isFinal)finalTranscript+=phrase+' ';else interim+=phrase}status.textContent=(finalTranscript+interim).trim()||'Ich höre zu …'};recognition.onerror=ev=>{status.textContent=ev.error==='not-allowed'?'Mikrofonzugriff verweigert. Bitte Berechtigung prüfen.':'Spracherkennung: '+ev.error};recognition.onend=()=>{isRecording=false;btn.classList.remove('recording');if(pressStarted){const spoken=finalTranscript.trim();pressStarted=false;if(spoken)startDraft(spoken);else status.textContent='Kein Text erkannt. Bitte erneut versuchen oder Text eingeben.'}};recognition.start()}catch(err){isRecording=false;pressStarted=false;status.textContent='Die Aufnahme konnte nicht gestartet werden. Bitte Text eingeben.'}}
function end(e){if(e)e.preventDefault();if(recognition&&isRecording){status.textContent='Verarbeite Sprache …';try{recognition.stop()}catch{}}else if(pressStarted){pressStarted=false}}
btn.addEventListener('pointerdown',begin);btn.addEventListener('pointerup',end);btn.addEventListener('pointercancel',end);btn.addEventListener('contextmenu',e=>e.preventDefault());}
function saveObservation(){draftText=$('draftText').value.trim();draftStudentId=$('draftStudent').value;if(!draftText){$('reviewMsg').textContent='Bitte gib zuerst eine Beobachtung ein.';return}if(!draftStudentId||!getStudent(draftStudentId)){$('reviewMsg').textContent='Bitte wähle den passenden Schüler aus.';return}const s=getStudent(draftStudentId);const now=new Date().toISOString();observations.push({id:id(),studentId:s.id,text:draftText,observation:draftText,createdAt:now,date:now,categories:['Beobachtungsnotiz','Entwicklungsverlauf']});saveData();chosenChronicleId=String(s.id);draftText='';draftStudentId='';page='profile';render()}
function exportData(){const blob=new Blob([JSON.stringify({exportedAt:new Date().toISOString(),students,observations},null,2)],{type:'application/json'});const url=URL.createObjectURL(blob);const a=document.createElement('a');a.href=url;a.download='paedagogischer-ki-assistent-testdaten.json';a.click();URL.revokeObjectURL(url)}
function clearData(){if(!confirm('Wirklich alle Schülerprofile und Beobachtungen aus diesem Browser löschen? Diese Aktion kann nicht rückgängig gemacht werden.'))return;students=[];observations=[];localStorage.removeItem(K_STUDENTS);localStorage.removeItem(K_OBS);localStorage.removeItem(K_CURRENT);go('home')}
document.querySelectorAll('.nav button').forEach(b=>b.addEventListener('click',()=>go(b.dataset.page)));render();
})();
</script>
</body>
</html>
